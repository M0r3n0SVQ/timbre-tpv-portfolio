# Copia este archivo a .env.local y rellénalo con los datos de tu proyecto de Supabase
# (Supabase Dashboard → Project Settings → API).
#
# Ambas variables son públicas por diseño: se incrustan en el JavaScript del navegador.
# NUNCA pongas aquí la clave service_role ni la contraseña de la base de datos.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
