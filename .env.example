# Copiar a .env.local. Son públicas (acaban en el JS del navegador):
# no pongas aquí la clave service_role ni la contraseña de la base de datos.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# Email de la cuenta del bar (el login solo pide la contraseña)
NEXT_PUBLIC_TPV_EMAIL=bar@ejemplo.com
